{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-beads-sidebar",
  "version": "0.1.0",
  "type": "module",
  "description": "Shows the current beads plan and its progress in the opencode sidebar",
  "license": "MIT",
  "author": "Tiarnán de Burca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nycdubliner/opencode-beads-sidebar.git"
  },
  "homepage": "https://github.com/nycdubliner/opencode-beads-sidebar#readme",
  "bugs": "https://github.com/nycdubliner/opencode-beads-sidebar/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "beads",
    "issue-tracker",
    "tui"
  ],
  "exports": {
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=1.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@opencode-ai/plugin": "1.18.16",
    "@opentui/core": "0.5.1",
    "@opentui/solid": "0.5.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "1.9.12",
    "typescript": "~7.0.2"
  }
}
